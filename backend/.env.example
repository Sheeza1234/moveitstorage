# MoveIt backend (Next.js route handlers + SQLite)

# SQLite file. Use ":memory:" for throw-away runs (the UAT scripts do).
MOVEIT_DB_PATH=./data/moveit.db

# What a brand-new database starts with:
#   none   -> completely empty. Warehouses, floors, zones, racks and positions are created from the portal
#             (default when NODE_ENV=production)
#   sample -> the bundled demo data set (default in development)
MOVEIT_SEED=none

# --- Postgres (Supabase, Neon, ...) -----------------------------------------------------------------------------
# When DATABASE_URL is set the backend uses Postgres instead of the SQLite file above. Tables are created on first start.
# Supabase: Project -> Connect -> "Transaction pooler" connection string (port 6543). Needed on Vercel/serverless.
# Leave it empty to keep using SQLite locally.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# First admin account on an empty database (production): pick your own password here.
# MOVEIT_ADMIN_PASSWORD=
